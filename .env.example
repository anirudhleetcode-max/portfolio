# ---------------------------------------------------------------------------
# Anirudh — portfolio site
#
# Copy to `.env.local` and fill in. Never commit `.env.local`.
# Every value below is optional: with none of them set the site runs against a
# local JSON file store and serves absolute URLs from http://localhost:3000.
# ---------------------------------------------------------------------------

# Public origin, used for metadataBase, Open Graph URLs, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Persistence for contact-form messages.
# Leave unset to use the JSON file store in ./.data (git-ignored).
# Set it to switch the same adapter interface over to MongoDB via Mongoose.
# MONGODB_URI=mongodb://127.0.0.1:27017
# MONGODB_DB=anirudh_portfolio

# ---------------------------------------------------------------------------
# Live demo URLs for the four projects.
#
# Each already falls back to the project's verified production alias, so these
# only need setting if a deployment moves. Anything that is not an absolute
# https:// URL is ignored, so a placeholder can never become a link claiming to
# be live; a project with no verifiable URL shows an honest "not deployed" state
# instead.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_LIVE_URL_SCAMSHIELD=https://<scamshield-deployment>
# NEXT_PUBLIC_LIVE_URL_SPENDLENS=https://<spendlens-deployment>
# NEXT_PUBLIC_LIVE_URL_FORMFIT=https://<formfit-deployment>
# NEXT_PUBLIC_LIVE_URL_NUTRISNAP=https://<nutrisnap-deployment>
