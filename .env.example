# ---------------------------------------------------------------------------
# Anirudh — portfolio site
#
# Copy to `.env.local` and fill in. Never commit `.env.local`.
# Every value below is optional: with none of them set the site runs against a
# local JSON file store and serves absolute URLs from http://localhost:3000.
# ---------------------------------------------------------------------------

# Public origin, used for metadataBase, Open Graph URLs, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Persistence for contact-form messages.
# Leave unset to use the JSON file store in ./.data (git-ignored).
# Set it to switch the same adapter interface over to MongoDB via Mongoose.
# MONGODB_URI=mongodb://127.0.0.1:27017
# MONGODB_DB=anirudh_portfolio

# ---------------------------------------------------------------------------
# Live demo URLs for the five projects.
#
# Leave a variable unset (or blank) and that project keeps the honest
# "Local demo · deployment pending" state. Set it to the project's REAL
# deployed https:// URL and its card and case study turn into a working
# "Live demo" link. Anything that is not an absolute https:// URL is ignored,
# so a placeholder can never become a link claiming to be live.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_LIVE_URL_BAKERY=https://<crumb-and-cream-deployment>
# NEXT_PUBLIC_LIVE_URL_CAFE=https://<noir-and-bean-deployment>
# NEXT_PUBLIC_LIVE_URL_EVENTS=https://<vanta-events-deployment>
# NEXT_PUBLIC_LIVE_URL_FITNESS=https://<form-x-deployment>
# NEXT_PUBLIC_LIVE_URL_STORE=https://<arc-and-form-deployment>
